# Database Configuration (PostgreSQL 16 via Docker or local)
# In local host development: postgresql+asyncpg://postgres:postgres@localhost:5432/ftmm_compass_dev
# Inside Docker container: postgresql+asyncpg://postgres:postgres@postgres:5432/ftmm_compass_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ftmm_compass_dev

# FTMM Compass Backend Configuration
# Port configuration (fallback automatically searches free port between 8001-8050 if unset)
BACKEND_PORT=8001
HOST=0.0.0.0

# Hybrid RAG-CAG Chatbot Microservice (Docker ftmm-compass-chatbot)
# In local host development: http://127.0.0.1:8000
# Inside Docker container: http://host.docker.internal:8000
CHATBOT_SERVICE_URL=http://127.0.0.1:8000
CHATBOT_TIMEOUT_SECONDS=45.0

