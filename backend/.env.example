# FTMM Compass Backend Configuration
# Port configuration (fallback automatically searches free port between 8001-8050 if unset)
BACKEND_PORT=8001
HOST=0.0.0.0

# Ollama / LLM Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b-instruct
# Hybrid RAG-CAG Chatbot Microservice (Docker)
CHATBOT_SERVICE_URL=http://127.0.0.1:8000
CHATBOT_TIMEOUT_SECONDS=45.0

# CORS Configuration
CORS_ORIGINS=*
